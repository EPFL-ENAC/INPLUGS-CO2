{% extends "layouts/main.njk" %}
{% block content %}
  <div class="links-content">
    <link rel="stylesheet" href='{{ asset("/assets/styles/links.css") }}'>
    <main class="links_page">
      <section class="news" id="news">
        <h2 class="info_title">{{ t("links.info") }}</h2>
      </section>
      <section class="references" id="references">
        <h1 class="references_title">{{ t("links.references.title") }}</h1>
        <h2 class="references_group_title">{{ t("links.references.ieaghg.title") }}</h2>
        <ul class="references_list">
          <li>
            <a href="{{ t("links.references.ieaghg.safe_storage.url") }}"
               target="_blank"
               rel="noopener">{{ t("links.references.ieaghg.safe_storage.title") }}</a>
          </li>
          <li>
            <a href="{{ t("links.references.ieaghg.site_catalogue.url") }}"
               target="_blank"
               rel="noopener">{{ t("links.references.ieaghg.site_catalogue.title") }}</a>
          </li>
        </ul>
        <h2 class="references_group_title">{{ t("links.references.iea.title") }}</h2>
        <ul class="references_list">
          <li>
            <a href="{{ t("links.references.iea.projects_explorer.url") }}"
               target="_blank"
               rel="noopener">{{ t("links.references.iea.projects_explorer.title") }}</a>
          </li>
          <li>
            <a href="{{ t("links.references.iea.role_of_storage.url") }}"
               target="_blank"
               rel="noopener">{{ t("links.references.iea.role_of_storage.title") }}</a>
          </li>
        </ul>
        <h2 class="references_group_title">{{ t("links.references.ipcc.title") }}</h2>
        <ul class="references_list">
          <li>
            <a href="{{ t("links.references.ipcc.ccs_report.url") }}"
               target="_blank"
               rel="noopener">{{ t("links.references.ipcc.ccs_report.title") }}</a>
          </li>
          <li>
            <a href="{{ t("links.references.ipcc.glossary.url") }}"
               target="_blank"
               rel="noopener">{{ t("links.references.ipcc.glossary.title") }}</a>
          </li>
        </ul>
        <h2 class="references_group_title">{{ t("links.references.journals.title") }}</h2>
        <ul class="references_list">
          <li>
            <a href="{{ t("links.references.journals.planetary_limit.url") }}"
               target="_blank"
               rel="noopener">{{ t("links.references.journals.planetary_limit.title") }}</a>
          </li>
        </ul>
      </section>
    </main>
  </div>
{% endblock %}
