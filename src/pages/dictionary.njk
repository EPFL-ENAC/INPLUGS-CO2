{% extends "layouts/main.njk" %}
{% block content %}
  <div class="data-content">
    <link rel="stylesheet" href='{{ asset("/assets/styles/dictionary.css") }}'>
    <main class="dictionary_page">
      <section class="dictionary" id="glossary">
        <h2 class="title">{{ t("dictionary.description") }}</h2>
        {% set glossary_keys = [
          "anthropogenic_emissions",
          "brine",
          "buoyancy",
          "caprock",
          "ccus",
          "density",
          "dissolution",
          "eor",
          "gcs",
          "hard_to_abate_emissions",
          "impermeable_rock",
          "injection",
          "injection_well",
          "mineralisation",
          "net_zero",
          "permeability",
          "phases",
          "pilot_project",
          "plume",
          "porosity",
          "reservoir",
          "residual_emissions",
          "saline_aquifer",
          "saturated_rock",
          "storage_capacity",
          "storage_integrity",
          "storage_locations",
          "supercritical_co2",
          "trapping_mechanisms",
          "viscosity"
        ] %}
        {% for key in glossary_keys %}
          <details>
            <summary id="{{ key }}">{{ t("dictionary." ~ key ~ ".term") }}</summary>
            <p>{{ t("dictionary." ~ key ~ ".definition") }}</p>
          </details>
        {% endfor %}
      </section>
    </main>
    <!-- <script type="module" src='{{ asset("/assets/js/dictionary.js") }}'></script> -->
  </div>
{% endblock %}
